{
  "name": "dsh-harness-notifier",
  "description": "DeepSeek Harness 通知插件：待审批/提问/回合结束/会话异常/断线恢复时，在 Web GUI 内多通道提醒（提示音、标签页徽标、OS 通知、通知中心、toast）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "notification",
    "alerts",
    "approval"
  ],
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js && node scripts/smoke.mjs"
  },
  "license": "MIT"
}
